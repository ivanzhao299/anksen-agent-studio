{
  "name": "anksen-agent-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone ANKSEN Agent Studio platform workspace.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "product:readiness": "node packages/orchestrator-core/bin/product-readiness.mjs",
    "software-domain:smoke": "node packages/software-engineering-domain/bin/software-domain-smoke.mjs",
    "domain-workflow:postgres:smoke": "node packages/domain-center/bin/domain-workflow-postgres-smoke.mjs",
    "smart-park:program:submit": "node packages/domain-center/bin/smart-park-program-submit.mjs",
    "domain-runner:start": "node packages/domain-center/bin/domain-runner.mjs",
    "lint:check": "node packages/orchestrator-core/bin/studio.mjs lint-check",
    "night-shift:smoke": "node packages/orchestrator-core/bin/night-shift-smoke.mjs",
    "night-shift:postgres:smoke": "node packages/orchestrator-core/bin/night-shift-postgres.mjs smoke",
    "night-shift:resume:smoke": "node packages/orchestrator-core/bin/night-shift-postgres.mjs resume",
    "night-shift:contention:test": "node packages/orchestrator-core/bin/night-shift-postgres.mjs contention",
    "activation-gate:smoke": "node packages/orchestrator-core/bin/activation-gate-smoke.mjs",
    "aec:smoke": "node packages/orchestrator-core/bin/aec-smoke.mjs",
    "beta-002:execute": "node packages/orchestrator-core/bin/beta-002-controlled-codex.mjs",
    "beta-002:resume": "node packages/orchestrator-core/bin/beta-002-controlled-codex.mjs --resume",
    "studio:codex:run": "node packages/orchestrator-core/bin/governed-codex-run.mjs",
    "studio-gateway:smoke": "node packages/orchestrator-core/bin/studio-gateway-smoke.mjs",
    "studio-mcp:start": "node packages/orchestrator-core/bin/studio-mcp-server.mjs",
    "studio-mcp:smoke": "node packages/orchestrator-core/bin/studio-mcp-smoke.mjs",
    "studio-mcp:oauth:check": "node packages/orchestrator-core/bin/studio-mcp-oauth-check.mjs",
    "studio-mcp:oauth:smoke": "node packages/orchestrator-core/bin/studio-mcp-oauth-smoke.mjs",
    "console:dev": "pnpm --filter @anksen/console dev",
    "console:service:status": "node packages/orchestrator-core/bin/studio.mjs console service status",
    "console:service:install": "node packages/orchestrator-core/bin/studio.mjs console service install --apply",
    "console:service:start": "node packages/orchestrator-core/bin/studio.mjs console service start --apply",
    "console:service:stop": "node packages/orchestrator-core/bin/studio.mjs console service stop --apply",
    "runtime-health-check": "node packages/runtime-center/bin/runtime-health-check.mjs --dry-run",
    "studio:doctor": "node packages/orchestrator-core/bin/studio.mjs doctor --project examples/jinhu-smart-park/project.config.example.json --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
