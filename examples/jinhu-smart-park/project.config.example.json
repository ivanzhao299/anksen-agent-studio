{
  "schema_version": 1,
  "project_id": "jinhu-smart-park",
  "project_name": "Jinhu Smart Park",
  "project_type": "business-repository",
  "description": "Jinhu Smart Park business project adapter for ANKSEN Agent Studio.",
  "project_root": "../jinhu-smart-park",
  "state_dir": "ops/agent-orchestrator",
  "mode": "external-project-adapter-example",
  "default_branch": "main",
  "package_manager": "pnpm",
  "worktrees": {
    "main": "../jinhu-smart-park",
    "agent-1": "../jinhu-smart-park-agent-1",
    "agent-2": "../jinhu-smart-park-agent-2",
    "agent-3": "../jinhu-smart-park-agent-3",
    "agent-4": "../jinhu-smart-park-agent-4",
    "agent-5": "../jinhu-smart-park-agent-5"
  },
  "detected_stack_hints": [
    "pnpm-workspace",
    "Next.js App Router",
    "React",
    "NestJS API",
    "TypeScript",
    "PostgreSQL",
    "Docker deployment scripts",
    "Agent Orchestrator project state"
  ],
  "available_commands": [
    "pnpm install",
    "pnpm typecheck",
    "pnpm lint",
    "pnpm build",
    "node ops/agent-orchestrator/scripts/orchestratorctl.mjs doctor",
    "node ops/agent-orchestrator/scripts/runtime-memory-read.mjs --summary",
    "node ops/agent-orchestrator/scripts/runtime-memory-validate.mjs",
    "node ops/agent-orchestrator/scripts/check-dispatch-status.mjs"
  ],
  "read_paths": [
    "ops/agent-orchestrator/events/**",
    "ops/agent-orchestrator/queue/**",
    "ops/agent-orchestrator/results/**",
    "ops/agent-orchestrator/reports/**",
    "ops/agent-orchestrator/runtime/**",
    "docs/release/**",
    "docs/testing/**"
  ],
  "write_paths": [
    "ops/agent-orchestrator/events/**",
    "ops/agent-orchestrator/queue/**",
    "ops/agent-orchestrator/results/**",
    "ops/agent-orchestrator/reports/**",
    "ops/agent-orchestrator/runtime/**"
  ],
  "frozen_paths": [
    "apps/**",
    "packages/**",
    "database/**",
    "infra/**",
    ".github/**",
    "Dockerfile",
    "Dockerfile.*",
    "docker-compose*",
    "deploy/**",
    "auth/**",
    ".env",
    ".env.*"
  ],
  "guarded_paths": [
    "apps/**",
    "packages/**",
    "database/**",
    "infra/**",
    ".github/**",
    "Dockerfile",
    "Dockerfile.*",
    "docker-compose*",
    "deploy/**",
    "auth/**",
    ".env",
    ".env.*"
  ],
  "runtime_memory": {
    "directory": "ops/agent-orchestrator/runtime",
    "summary_file": "handoff-summary.md",
    "platform_state_file": "platform-state.json",
    "validate_command": "node ops/agent-orchestrator/scripts/runtime-memory-validate.mjs"
  },
  "inspection": {
    "dry_run_only": true,
    "allow_agent_execution": false,
    "allow_project_writes": false,
    "allow_deploy": false,
    "allow_production_operations": false
  },
  "production_operations": {
    "deploy": "forbidden",
    "migration": "forbidden",
    "seed": "forbidden",
    "reset": "forbidden",
    "cleanup": "forbidden"
  }
}
