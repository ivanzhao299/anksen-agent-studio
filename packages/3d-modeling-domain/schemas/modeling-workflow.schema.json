{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.anksen.dev/schemas/modeling-workflow.schema.json",
  "title": "ANKSEN 3D Modeling Workflow Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "workflowId",
    "assetId",
    "sourceMesh",
    "referenceManifest",
    "outputRoot",
    "targetHeightMm",
    "surfaceSubdivisionLevel",
    "surfaceMethod",
    "surfaceProfile",
    "featureAngleDegrees",
    "featureProtectionRings",
    "semanticRegions",
    "riskLevel",
    "constraints",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domain": { "const": "3D_MODELING" },
    "workflowId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "sourceMesh": { "type": "string", "minLength": 1 },
    "referenceManifest": { "type": "string", "minLength": 1 },
    "outputRoot": { "type": "string", "minLength": 1 },
    "targetHeightMm": { "type": "number", "minimum": 20, "maximum": 1000 },
    "surfaceSubdivisionLevel": { "type": "integer", "minimum": 0, "maximum": 2 },
    "surfaceMethod": { "enum": ["voxel", "catmull-clark", "relax-only"] },
    "surfaceProfile": { "enum": ["uniform", "feature-preserving"] },
    "featureAngleDegrees": { "type": "number", "minimum": 20, "maximum": 120 },
    "featureProtectionRings": { "type": "integer", "minimum": 0, "maximum": 5 },
    "semanticRegions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/semanticRegion" }
    },
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "constraints": { "$ref": "#/$defs/nonEmptyStrings" },
    "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "semanticRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semanticClass", "treatment", "ownerReviewRequired"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "semanticClass": {
          "enum": [
            "ORGANIC_SHELL",
            "HARD_SURFACE",
            "JOINT_INTERFACE",
            "RELIEF",
            "MATERIAL_BOUNDARY"
          ]
        },
        "treatment": { "enum": ["FAIR", "PRESERVE", "REBUILD", "SEPARATE"] },
        "ownerReviewRequired": { "type": "boolean" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
