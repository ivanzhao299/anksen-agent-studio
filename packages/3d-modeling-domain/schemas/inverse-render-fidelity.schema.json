{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/schemas/inverse-render-fidelity.schema.json",
  "title": "Inverse Render Fidelity Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "evaluationMode",
    "workflowId",
    "assetId",
    "baselineVersion",
    "referenceManifest",
    "candidateRenderRoot",
    "candidateSilhouetteRoot",
    "outputRoot",
    "viewAuthority",
    "metrics",
    "semanticRegions",
    "promotion",
    "riskLevel",
    "constraints",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domain": { "const": "3D_MODELING" },
    "evaluationMode": { "const": "HIGH_RESOLUTION_INVERSE_RENDER_ALIGNMENT" },
    "workflowId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "assetId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "baselineVersion": { "type": "string", "minLength": 1 },
    "referenceManifest": { "type": "string", "minLength": 1 },
    "candidateRenderRoot": { "type": "string", "minLength": 1 },
    "candidateSilhouetteRoot": { "type": "string", "minLength": 1 },
    "outputRoot": { "type": "string", "minLength": 1 },
    "viewAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritativeFrontWeight",
        "generatedViewWeight",
        "generatedViewsAreMetric"
      ],
      "properties": {
        "authoritativeFrontWeight": { "type": "number", "exclusiveMinimum": 0 },
        "generatedViewWeight": { "type": "number", "exclusiveMinimum": 0 },
        "generatedViewsAreMetric": { "const": false }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "silhouetteIou",
        "edgeChamferSimilarity",
        "multiscaleStructuralSimilarity",
        "colorMaterialSimilarity"
      ],
      "properties": {
        "silhouetteIou": { "const": true },
        "edgeChamferSimilarity": { "const": true },
        "multiscaleStructuralSimilarity": { "const": true },
        "colorMaterialSimilarity": { "const": true }
      }
    },
    "semanticRegions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "box", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
          "box": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "items": false
          },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automaticMasterOverwrite",
        "requireNoAuthoritativeFrontRegression",
        "requireAllSemanticRegions",
        "targets"
      ],
      "properties": {
        "automaticMasterOverwrite": { "const": false },
        "requireNoAuthoritativeFrontRegression": { "const": true },
        "requireAllSemanticRegions": { "const": true },
        "targets": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
