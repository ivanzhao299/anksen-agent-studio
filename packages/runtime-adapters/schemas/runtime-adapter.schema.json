{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen-agent-studio.local/schemas/runtime-adapters/runtime-adapter.schema.json",
  "title": "Runtime Adapter Registry",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "adapters"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "adapter_id",
          "runtime_id",
          "provider",
          "invoke_mode",
          "supported_skills",
          "credential_reference_required",
          "network_required",
          "workspace_required",
          "max_parallel_tasks",
          "health_status",
          "risk_baseline",
          "guardrails"
        ],
        "additionalProperties": false,
        "properties": {
          "adapter_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "runtime_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "invoke_mode": {
            "enum": [
              "cli",
              "api",
              "browser",
              "remote-worker",
              "webhook"
            ]
          },
          "supported_skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "credential_reference_required": {
            "type": "boolean"
          },
          "credential_reference_id": {
            "type": "string",
            "minLength": 1
          },
          "network_required": {
            "type": "boolean"
          },
          "workspace_required": {
            "type": "boolean"
          },
          "max_parallel_tasks": {
            "type": "integer",
            "minimum": 1
          },
          "health_status": {
            "enum": [
              "unknown",
              "healthy",
              "degraded",
              "unavailable",
              "disabled"
            ]
          },
          "risk_baseline": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "guardrails": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
