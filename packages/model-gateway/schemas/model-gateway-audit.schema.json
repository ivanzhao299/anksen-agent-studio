{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/schemas/model-gateway-audit.schema.json",
  "title": "Model Gateway Audit",
  "type": "object",
  "required": ["schema_version", "audit_id", "gateway_id", "events"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "audit_id": { "type": "string" },
    "gateway_id": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_type", "status", "credential_values_read", "model_invocation"],
        "properties": {
          "event_type": { "type": "string" },
          "status": { "type": "string" },
          "credential_values_read": { "const": false },
          "model_invocation": { "enum": ["disabled"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
