{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/project-config.schema.json",
  "title": "ANKSEN Agent Studio Project Connector Config",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "project_name",
    "project_root",
    "state_dir",
    "worktrees",
    "read_paths",
    "write_paths",
    "frozen_paths",
    "production_operations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "project_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string"
    },
    "default_branch": {
      "type": "string"
    },
    "package_manager": {
      "type": "string"
    },
    "worktrees": {
      "type": "object",
      "required": ["main"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "detected_stack_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intake": {
      "type": "object",
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "enum": ["local_path", "git_url", "zip_placeholder"]
        },
        "local_path": {
          "type": "string"
        },
        "git_url": {
          "type": "string"
        },
        "zip_placeholder": {
          "type": "string"
        },
        "repo_metadata": {
          "type": "object",
          "properties": {
            "default_branch": {
              "type": "string"
            },
            "package_manager": {
              "type": "string"
            },
            "monorepo": {
              "type": "boolean"
            },
            "repository_kind": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "read_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frozen_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guarded_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_memory": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        },
        "summary_file": {
          "type": "string"
        },
        "platform_state_file": {
          "type": "string"
        },
        "validate_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "inspection": {
      "type": "object",
      "properties": {
        "dry_run_only": {
          "type": "boolean"
        },
        "allow_agent_execution": {
          "type": "boolean"
        },
        "allow_project_writes": {
          "type": "boolean"
        },
        "allow_deploy": {
          "type": "boolean"
        },
        "allow_production_operations": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "production_operations": {
      "type": "object",
      "required": ["deploy", "migration", "seed", "reset", "cleanup"],
      "properties": {
        "deploy": {
          "type": "string"
        },
        "migration": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "reset": {
          "type": "string"
        },
        "cleanup": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
