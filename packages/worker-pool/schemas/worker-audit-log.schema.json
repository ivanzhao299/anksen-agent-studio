{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/worker-audit-log.schema.json",
  "title": "Worker Audit Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "created_at", "event_type", "worker_id", "runtime_id", "dry_run", "safety"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "audit_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "enum": ["worker.list", "worker.health", "worker.assign", "worker.cancel"] },
    "worker_id": { "type": "string", "minLength": 1 },
    "runtime_id": { "type": "string", "minLength": 1 },
    "dry_run": { "type": "boolean" },
    "safety": { "type": "object", "additionalProperties": true }
  }
}
