{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/worker-registry.schema.json",
  "title": "Worker Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "updated_at", "workers"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "registry_id": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "workers": {
      "type": "array",
      "items": { "$ref": "worker-profile.schema.json" }
    },
    "required_capability_tags": {
      "type": "array",
      "items": { "type": "string", "enum": ["codex", "mobile-ios", "mobile-android", "web", "backend", "discovery", "production-dry-run", "media-generation", "media-editing", "media-qa"] },
      "uniqueItems": true
    },
    "future_worker_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["worker_kind", "default_risk", "default_execution_mode"],
        "properties": {
          "worker_kind": { "type": "string", "enum": ["local", "remote", "production"] },
          "worker_os": { "type": "string" },
          "capability_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "default_risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "default_execution_mode": { "type": "string" }
        }
      }
    }
  }
}
