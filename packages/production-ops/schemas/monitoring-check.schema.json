{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen-agent-studio.local/schemas/production-ops/monitoring-check.schema.json",
  "title": "Monitoring Check",
  "type": "object",
  "required": ["schema_version", "check_bundle_id", "mode", "target_environment", "risk", "execution_mode", "checks", "safety"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "check_bundle_id": { "type": "string", "minLength": 1 },
    "mode": { "const": "dry_run_only" },
    "target_environment": { "type": "string", "minLength": 1 },
    "risk": { "const": "HIGH" },
    "execution_mode": { "const": "proposal_only" },
    "approval_required_for_execution": { "const": "CRITICAL" },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["check_id", "title", "source_ref", "execution_status"],
      "additionalProperties": false,
      "properties": {
        "check_id": { "type": "string" },
        "title": { "type": "string" },
        "source_ref": { "type": "string" },
        "execution_status": { "const": "not_executed" },
        "notes": { "type": "string" }
      }
    },
    "safety": {
      "type": "object",
      "required": ["server_access", "deploy", "production_operations", "credential_values"],
      "additionalProperties": false,
      "properties": {
        "server_access": { "const": "disabled" },
        "deploy": { "const": "disabled" },
        "production_operations": { "const": "disabled" },
        "credential_values": { "const": "not_read" }
      }
    }
  }
}
