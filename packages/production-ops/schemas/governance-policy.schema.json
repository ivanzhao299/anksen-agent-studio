{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen-agent-studio.local/schemas/production-ops/governance-policy.schema.json",
  "title": "Governance Policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "mode",
    "forbidden_operations",
    "approval_required_for",
    "audit_required",
    "credential_values",
    "server_access",
    "deploy_execution",
    "production_operations",
    "managed_project_writes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "dry_run_only"
    },
    "forbidden_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/operation_category"
      }
    },
    "approval_required_for": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/operation_category"
      }
    },
    "audit_required": {
      "type": "boolean"
    },
    "credential_values": {
      "const": "forbidden"
    },
    "server_access": {
      "const": "forbidden"
    },
    "deploy_execution": {
      "const": "forbidden"
    },
    "production_operations": {
      "const": "forbidden"
    },
    "managed_project_writes": {
      "const": "approval_required"
    },
    "safety_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "operation_category": {
      "enum": [
        "documentation_only",
        "local_repo_change",
        "agent_execution",
        "managed_project_write",
        "deploy",
        "production_operation",
        "server_access",
        "credential_value_access"
      ]
    }
  }
}
