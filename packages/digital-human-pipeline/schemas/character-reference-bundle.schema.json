{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/schemas/character-reference-bundle.schema.json",
  "title": "Character Reference Bundle",
  "type": "object",
  "required": ["schemaVersion", "bundleId", "source", "characters", "contactSheet"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "width", "height", "layout"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "layout": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assetId", "displayName", "archetype", "identityMode", "views", "quality"],
        "properties": {
          "assetId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "archetype": { "type": "string", "minLength": 1 },
          "identityMode": { "const": "source-sheet-crop" },
          "sourcePanel": {
            "type": "array",
            "prefixItems": [
              { "type": "integer" },
              { "type": "integer" },
              { "type": "integer" },
              { "type": "integer" }
            ],
            "items": false
          },
          "views": {
            "type": "object",
            "required": ["panel", "hero", "front", "side", "back", "expressions"],
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "recommendedElementReferences": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1 }
          },
          "quality": {
            "type": "object",
            "required": ["front", "side", "back", "expressions", "hiddenSurfaces"],
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "contactSheet": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
