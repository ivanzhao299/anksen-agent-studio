{
  "manifestVersion": 5,
  "id": "com.anksen.studio.photoshop.connected",
  "name": "ANKSEN Studio for Photoshop Connected",
  "version": "0.1.0",
  "main": "index.html",
  "host": {"app": "PS", "minVersion": "24.4.0"},
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {"domains": ["https://REPLACE-WITH-APPROVED-STUDIO-DOMAIN.example"]}
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "anksenStudioPanel",
      "label": {"default": "ANKSEN Studio", "zh_CN": "安科森设计执行"},
      "minimumSize": {"width": 300, "height": 420},
      "maximumSize": {"width": 1200, "height": 1600},
      "preferredDockedSize": {"width": 340, "height": 620},
      "preferredFloatingSize": {"width": 420, "height": 720}
    }
  ]
}
