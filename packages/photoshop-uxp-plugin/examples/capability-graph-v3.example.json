        "command": { "operation": "CREATE_WORK_PATH_FROM_SELECTION", "parameters": { "tolerance": 2 }, "expectedResult": "把批准的主视觉窗口固化为可编辑工作路径" }
      },
      {
        "nodeId": "clear-before-path-load",
