        "command": { "operation": "CREATE_REVEAL_SELECTION_MASK", "target": { "nodeOutput": "hero" }, "parameters": {}, "expectedResult": "以大幅柔边矩形蒙版塑造主视觉空间" }
      },
      {
        "nodeId": "clear-selection",
        "dependsOn": ["hero-mask"],
        "command": { "operation": "DESELECT", "parameters": {} }
      },
      {
        "nodeId": "hero-blend",
