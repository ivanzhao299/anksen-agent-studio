{
  "manifestVersion": 5,
  "id": "com.anksen.studio.photoshop",
  "name": "ANKSEN Studio for Photoshop",
  "version": "0.3.0",
  "main": "index.html",
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
  ],
  "host": {
    "app": "PS",
    "minVersion": "24.4.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "anksenStudioPanel",
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
      ],
      "minimumSize": {
        "width": 260,
        "height": 360
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 680
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 720
      },
      "label": {
        "default": "ANKSEN Studio for Photoshop"
      }
    }
  ]
}
