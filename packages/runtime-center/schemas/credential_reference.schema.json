{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/credential_reference.schema.json",
  "title": "ANKSEN Agent Studio Credential Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_id", "credential_type", "vault_path", "provider"],
  "not": {
    "anyOf": [
      { "required": ["api_key"] },
      { "required": ["ssh_key"] },
      { "required": ["private_key"] },
      { "required": ["token"] },
      { "required": ["secret"] },
      { "required": ["password"] }
    ]
  },
  "properties": {
    "credential_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "credential_type": {
      "type": "string",
      "enum": ["api_key_ref", "oauth_ref", "local_login_ref", "ssh_ref", "none"]
    },
    "vault_path": {
      "type": "string",
      "description": "Reference path only. Do not store real API keys, SSH keys, tokens, secrets, or passwords here."
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "notes": {
      "type": "string"
    }
  }
}
