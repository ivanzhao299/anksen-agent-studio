{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/runtime-profile.schema.json",
  "title": "ANKSEN Agent Studio Runtime Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "profiles"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_id",
          "adapter_id",
          "provider",
          "invoke_mode",
          "supported_skills",
          "max_parallel_tasks",
          "default_budget",
          "region",
          "health_status",
          "preferred_projects"
        ],
        "properties": {
          "runtime_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "adapter_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "invoke_mode": {
            "type": "string",
            "enum": ["api", "cli", "browser", "remote-worker", "local"]
          },
          "supported_skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "max_parallel_tasks": {
            "type": "integer",
            "minimum": 1
          },
          "default_budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_minutes", "max_usd"],
            "properties": {
              "max_minutes": {
                "type": "integer",
                "minimum": 1
              },
              "max_usd": {
                "type": "number",
                "minimum": 0
              },
              "max_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "health_status": {
            "type": "string",
            "enum": ["unknown", "healthy", "degraded", "unavailable", "disabled"]
          },
          "preferred_projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
