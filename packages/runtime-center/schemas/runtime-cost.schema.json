{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/runtime-cost.schema.json",
  "title": "ANKSEN Agent Studio Runtime Cost Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "cost_profiles"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cost_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime_id", "provider", "pricing_model", "currency", "unit"],
        "properties": {
          "runtime_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "pricing_model": {
            "type": "string",
            "enum": ["token", "seat", "time", "self_hosted", "unknown"]
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "unit": {
            "type": "string"
          },
          "estimated_input_unit_cost": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "estimated_output_unit_cost": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
