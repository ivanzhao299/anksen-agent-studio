{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/credential-scope.schema.json",
  "title": "Credential Scope Check",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_id", "status", "dry_run", "scope", "secret_values_read"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "runtime_id": { "type": "string", "minLength": 1 },
    "credential_reference_id": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "dry_run": { "type": "boolean", "const": true },
    "scope": { "type": "object", "additionalProperties": true },
    "secret_values_read": { "type": "string", "enum": ["no"] },
    "env_read": { "type": "string", "enum": ["no"] },
    "keychain_read": { "type": "string", "enum": ["no"] },
    "external_vault_read": { "type": "string", "enum": ["no"] },
    "findings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
