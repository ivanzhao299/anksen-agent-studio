{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/credential.schema.json",
  "title": "ANKSEN Agent Studio Credential References",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "credential_references"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "credential_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_id", "provider", "credential_type", "reference", "status"],
        "not": {
          "anyOf": [
            { "required": ["api_key"] },
            { "required": ["secret"] },
            { "required": ["token"] },
            { "required": ["password"] },
            { "required": ["private_key"] },
            { "required": ["ssh_key"] }
          ]
        },
        "properties": {
          "credential_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "credential_type": {
            "type": "string",
            "enum": ["api_key_ref", "oauth_ref", "local_login_ref", "ssh_ref", "none"]
          },
          "reference": {
            "$ref": "secret-reference.schema.json"
          },
          "status": {
            "type": "string",
            "enum": ["reference_only", "missing", "disabled", "not_required"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
