{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/secret-reference.schema.json",
  "title": "ANKSEN Agent Studio Secret Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference_type"],
  "not": {
    "anyOf": [
      { "required": ["api_key"] },
      { "required": ["secret"] },
      { "required": ["token"] },
      { "required": ["password"] },
      { "required": ["private_key"] },
      { "required": ["ssh_key"] }
    ]
  },
  "properties": {
    "reference_type": {
      "type": "string",
      "enum": ["vault_path", "env_ref", "keychain_ref", "external_vault_ref"]
    },
    "vault_path": {
      "type": "string",
      "pattern": "^(vault|none)://.+"
    },
    "env_ref": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "keychain_ref": {
      "type": "string",
      "minLength": 1
    },
    "external_vault_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    { "required": ["vault_path"] },
    { "required": ["env_ref"] },
    { "required": ["keychain_ref"] },
    { "required": ["external_vault_ref"] }
  ]
}
