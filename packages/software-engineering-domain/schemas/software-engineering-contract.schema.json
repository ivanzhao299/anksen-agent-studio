{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.anksen.dev/schemas/software-engineering-contract.schema.json",
  "title": "ANKSEN Software Engineering Domain Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domain", "contractId", "objective", "projectRootReference", "allowedPaths", "blockedPaths", "constraints", "acceptanceCriteria", "validationCommands", "expectedArtifacts", "riskLevel", "maxAttempts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domain": { "const": "SOFTWARE_ENGINEERING" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "objective": { "type": "string", "minLength": 1 },
    "projectRootReference": { "type": "string", "minLength": 1 },
    "allowedPaths": { "$ref": "#/$defs/nonEmptyStrings" },
    "blockedPaths": { "$ref": "#/$defs/nonEmptyStrings" },
    "constraints": { "$ref": "#/$defs/nonEmptyStrings" },
    "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStrings" },
    "validationCommands": { "$ref": "#/$defs/nonEmptyStrings" },
    "expectedArtifacts": { "$ref": "#/$defs/nonEmptyStrings" },
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 }
  },
  "$defs": {
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
