{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/planning-output.schema.json",
  "title": "ANKSEN Agent Studio Planning Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planning_output_id",
    "source_request_id",
    "goal",
    "current_stage",
    "next_action",
    "reason",
    "target_project",
    "target_package",
    "expected_files",
    "validation_commands",
    "risk",
    "approval_required",
    "stop_condition"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "planning_output_id": {
      "type": "string",
      "minLength": 1
    },
    "source_request_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "current_stage": {
      "type": "object",
      "additionalProperties": true
    },
    "next_action": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "reason", "target_project", "target_package", "expected_files", "validation_commands", "risk", "approval_required"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "target_project": {
      "type": "string",
      "minLength": 1
    },
    "target_package": {
      "type": "string",
      "minLength": 1
    },
    "expected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "approval_required": {
      "type": "boolean"
    },
    "execution_mode": {
      "type": "string",
      "enum": ["local_repo_execute", "proposal_only", "approval_gate", "blocked", "human_approval_required"]
    },
    "batch_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "tasks"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string"
        },
        "source_planning_output_id": {
          "type": "string"
        },
        "source_action_title": {
          "type": "string"
        },
        "parallelism": {
          "type": "object",
          "additionalProperties": true
        },
        "execution_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "tasks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "task_id",
              "owner_agent",
              "target_package",
              "skill_type",
              "runtime",
              "allowed_paths",
              "forbidden_paths",
              "risk",
              "dependencies",
              "validation_commands"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "owner_agent": {
                "type": "string",
                "pattern": "^agent-[1-5]$"
              },
              "target_package": {
                "type": "string",
                "minLength": 1
              },
              "skill_type": {
                "type": "string",
                "minLength": 1
              },
              "runtime": {
                "type": "string",
                "minLength": 1
              },
              "allowed_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forbidden_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "risk": {
                "type": "string",
                "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "validation_commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "stop_condition": {
      "type": "string",
      "minLength": 1
    }
  }
}
