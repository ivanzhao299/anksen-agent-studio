{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/agent-studio/v5-master-plan.schema.json",
  "title": "ANKSEN Agent Studio V5 Master Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "generated_at",
    "source_doc",
    "current_phase",
    "safety_policy",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_doc": {
      "type": "string",
      "minLength": 1
    },
    "current_phase": {
      "type": "string",
      "minLength": 1
    },
    "safety_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_execution",
        "credential_values",
        "deploy",
        "production_operations",
        "managed_project_writes",
        "high_critical_policy"
      ],
      "properties": {
        "worker_execution": {
          "type": "string",
          "enum": ["disabled", "proposal_only", "approval_required"]
        },
        "credential_values": {
          "type": "string",
          "enum": ["disabled", "reference_only", "approval_required"]
        },
        "deploy": {
          "type": "string",
          "enum": ["disabled", "proposal_only", "approval_required"]
        },
        "production_operations": {
          "type": "string",
          "enum": ["disabled", "proposal_only", "approval_required"]
        },
        "managed_project_writes": {
          "type": "string",
          "enum": ["disabled", "proposal_only", "approval_required"]
        },
        "high_critical_policy": {
          "type": "string",
          "enum": ["proposal_only"]
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "order",
          "objective",
          "milestones",
          "dependencies",
          "risk_level",
          "automation_level",
          "approval_required",
          "execution_mode",
          "target_project",
          "target_package",
          "expected_files",
          "validation_commands"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V5-[A-F]$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "milestones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk_level": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "automation_level": {
            "type": "string",
            "enum": ["automatic_execute", "autopilot_execute", "proposal_only", "human_approval_required"]
          },
          "approval_required": {
            "type": "boolean"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["local_repo_execute", "proposal_only", "human_approval_required"]
          },
          "target_project": {
            "type": "string",
            "minLength": 1
          },
          "target_package": {
            "type": "string",
            "minLength": 1
          },
          "expected_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
