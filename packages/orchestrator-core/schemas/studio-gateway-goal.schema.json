{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.anksen.example/schemas/studio-gateway-goal.schema.json",
  "title": "Create Studio Goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "projectId", "idempotencyKey"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "description": { "type": "string", "maxLength": 10000 },
    "organizationId": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "constraints": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } },
    "acceptanceCriteria": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } }
  }
}
