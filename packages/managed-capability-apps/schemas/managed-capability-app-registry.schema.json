{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen-agent-studio.local/schemas/managed-capability-app-registry.schema.json",
  "title": "Managed Capability App Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "apps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "registry_id": { "type": "string", "minLength": 1 },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["app_id", "name", "category", "license", "capabilities", "installation", "native_ui", "boundary"],
        "additionalProperties": false,
        "properties": {
          "app_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "installation": {
            "type": "object",
            "required": ["root_env", "local_path_candidates", "manifest", "bridge_entry", "python"],
            "additionalProperties": false,
            "properties": {
              "root_env": { "type": "string", "minLength": 1 },
              "local_path_candidates": { "type": "array", "items": { "type": "string" } },
              "manifest": { "type": "string", "minLength": 1 },
              "bridge_entry": { "type": "string", "minLength": 1 },
              "python": { "type": "string", "minLength": 1 }
            }
          },
          "native_ui": { "type": "object", "required": ["origin", "project_path_template"], "additionalProperties": false, "properties": { "origin": { "type": "string" }, "project_path_template": { "type": "string" } } },
          "boundary": { "type": "object", "required": ["integration_mode", "studio_orchestration", "progress", "artifacts"], "additionalProperties": false, "properties": { "integration_mode": { "const": "INDEPENDENT_MANAGED_APP" }, "studio_orchestration": { "const": "HANDOFF_ONLY" }, "progress": { "const": "READ_ONLY_PROJECTION" }, "artifacts": { "const": "READ_ONLY_DISCOVERY" } } },
          "deployment": { "type": "object", "required": ["repository", "commit", "root", "service", "health_url"], "additionalProperties": false, "properties": { "repository": { "type": "string", "pattern": "^https://github.com/" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "root": { "type": "string", "pattern": "^/opt/anksen/" }, "service": { "type": "string" }, "health_url": { "type": "string", "pattern": "^http://127.0.0.1:" } } }
        }
      }
    }
  }
}
