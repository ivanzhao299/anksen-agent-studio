{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anksen.local/schemas/workspace-membership.schema.json",
  "title": "Workspace Memberships",
  "type": "object",
  "required": ["schema_version", "workspace_id", "memberships"],
  "properties": {
    "schema_version": { "const": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "memberships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "membership_id",
          "workspace_id",
          "user_id",
          "status",
          "plan_id",
          "role_ids",
          "project_allowlist",
          "beta_features"
        ],
        "properties": {
          "membership_id": { "type": "string", "minLength": 1 },
          "workspace_id": { "type": "string", "minLength": 1 },
          "user_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ACTIVE", "PENDING", "SUSPENDED"] },
          "plan_id": { "type": "string", "minLength": 1 },
          "role_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "project_allowlist": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "beta_features": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
