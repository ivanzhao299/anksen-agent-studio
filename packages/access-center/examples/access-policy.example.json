{
  "schema_version": 1,
  "policy_id": "studio-access-policy-mvp",
  "auth_mode": "local_password_session",
  "default_workspace_id": "anksen-agent-studio-local",
  "default_console_user_id": "studio-owner",
  "session_ttl_hours": 12,
  "allow_anonymous_console_read": false,
  "capability_catalog": [
    "console.access",
    "console.attachments",
    "context.read",
    "project.read",
    "runtime.read",
    "worker.read",
    "credential.read",
    "governance.read",
    "autopilot.plan",
    "autopilot.execute.local",
    "proposal.review",
    "proposal.create",
    "proposal.approve",
    "proposal.reject",
    "production.request",
    "agent.runtime.readonly",
    "agent.runtime.status",
    "access.manage",
    "multi_project.visible",
    "smart_park.workspace",
    "work.read",
    "business.operate",
    "business.work.control",
    "business.manage",
    "strategy.read",
    "hr.read",
    "finance.read",
    "sales.read",
    "manufacturing.read",
    "media.read"
  ],
  "roles": [
    {
      "role_id": "platform_owner",
      "display_name": "平台所有者",
      "description": "管理 Studio 全局能力、内测权限和关键执行边界。",
      "capabilities": ["*"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": true
    },
    {
      "role_id": "workspace_admin",
      "display_name": "工作台管理员",
      "description": "可管理本地 Console、项目入口和大部分 LOW/MEDIUM 本仓库动作。",
      "capabilities": [
        "console.access",
        "console.attachments",
        "context.read",
        "project.read",
        "runtime.read",
        "worker.read",
        "credential.read",
        "governance.read",
        "autopilot.plan",
        "autopilot.execute.local",
        "proposal.review",
        "proposal.create",
        "proposal.approve",
        "proposal.reject",
        "agent.runtime.readonly",
        "agent.runtime.status",
        "multi_project.visible",
        "smart_park.workspace",
        "business.operate",
        "business.work.control",
        "business.manage"
      ],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "operator",
      "display_name": "运营执行者",
      "description": "可以读取上下文、查看运行时和执行受治理的 LOW/MEDIUM 本地动作。",
      "capabilities": [
        "console.access",
        "console.attachments",
        "context.read",
        "project.read",
        "runtime.read",
        "worker.read",
        "credential.read",
        "governance.read",
        "autopilot.plan",
        "autopilot.execute.local",
        "proposal.review",
        "proposal.create",
        "agent.runtime.readonly",
        "agent.runtime.status",
        "smart_park.workspace"
      ],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "reviewer",
      "display_name": "审批审阅者",
      "description": "查看 Proposal、生成审批草稿和审核治理结果。",
      "capabilities": [
        "console.access",
        "context.read",
        "project.read",
        "runtime.read",
        "worker.read",
        "credential.read",
        "governance.read",
        "autopilot.plan",
        "proposal.review",
        "proposal.create",
        "proposal.approve",
        "proposal.reject",
        "multi_project.visible",
        "smart_park.workspace"
      ],
      "direct_execute_max_risk": "LOW",
      "can_manage_access": false
    },
    {
      "role_id": "viewer",
      "display_name": "只读观察者",
      "description": "只能查看 Console、上下文和运行态，不可发起执行。",
      "capabilities": [
        "console.access",
        "context.read",
        "project.read",
        "runtime.read",
        "worker.read",
        "credential.read",
        "governance.read",
        "multi_project.visible"
      ],
      "direct_execute_max_risk": "LOW",
      "can_manage_access": false
    },
    {
      "role_id": "security_admin",
      "display_name": "安全管理员",
      "description": "负责访问策略、账号状态和套餐门禁。",
      "capabilities": [
        "console.access",
        "context.read",
        "governance.read",
        "proposal.review",
        "access.manage"
      ],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": true
    },
    {
      "role_id": "strategy_operator",
      "display_name": "战略执行用户",
      "description": "使用战略目标、指标、举措、复盘和相关智能工作流。",
      "capabilities": ["console.access", "work.read", "strategy.read", "business.operate", "business.work.control", "autopilot.plan"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "hr_operator",
      "display_name": "人力资源用户",
      "description": "使用组织、岗位、员工、招聘和入职业务功能。",
      "capabilities": ["console.access", "work.read", "hr.read", "business.operate", "business.work.control", "autopilot.plan"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "finance_operator",
      "display_name": "财务业务用户",
      "description": "使用预算、费用、应收应付和财务分析功能。",
      "capabilities": ["console.access", "work.read", "finance.read", "business.operate", "business.work.control", "autopilot.plan"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "finance_reviewer",
      "display_name": "财务审批用户",
      "description": "复核财务单据并执行版本绑定审批，不具备 Runtime、部署或平台管理权限。",
      "capabilities": ["console.access", "work.read", "finance.read", "business.operate", "proposal.approve"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "sales_operator",
      "display_name": "增长销售用户",
      "description": "使用产品、营销活动、线索、客户、商机和服务流程。",
      "capabilities": ["console.access", "work.read", "sales.read", "media.read", "business.operate", "business.work.control", "autopilot.plan"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "manufacturing_operator",
      "display_name": "制造业务用户",
      "description": "使用物料、BOM、工单、库存和质量业务功能。",
      "capabilities": ["console.access", "work.read", "manufacturing.read", "business.operate", "business.work.control", "autopilot.plan"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    },
    {
      "role_id": "smart_park_operator",
      "display_name": "智慧园区用户",
      "description": "使用企业、空间、合同、工单和能源业务功能。",
      "capabilities": ["console.access", "work.read", "smart_park.workspace", "business.operate", "business.work.control", "autopilot.plan"],
      "direct_execute_max_risk": "MEDIUM",
      "can_manage_access": false
    }
  ]
}
