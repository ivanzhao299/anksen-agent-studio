# Public HTTPS origin terminated by the existing office nginx boundary.
GITEA_DOMAIN=git.cnjinhu.com
GITEA_HTTP_PORT=4340

# SSH is office-LAN only by default. Do not expose it publicly without a
# separately reviewed TCP proxy and firewall policy.
GITEA_SSH_DOMAIN=192.168.2.204
GITEA_SSH_BIND_ADDRESS=192.168.2.204
GITEA_SSH_PORT=2222

# Database-backed interactive sessions survive controlled service restarts.
# Ordinary sessions last 30 days; remembered devices last up to 365 days.
GITEA_SESSION_LIFE_TIME_SECONDS=2592000
GITEA_LOGIN_REMEMBER_DAYS=365

GITEA_RUNNER_NAME=office-204-ci-1
GITEA_RUNNER_LABELS=ubuntu-22.04:docker://node:22-bookworm
# Optional override for private DNS or integration tests. Production normally
# omits this and uses https://${GITEA_DOMAIN}.
# GITEA_RUNNER_INSTANCE_URL=https://git.cnjinhu.com

# Persistent runtime state. This path must not be inside a Git checkout.
GITEA_STATE_DIR=/opt/anksen/gitea
